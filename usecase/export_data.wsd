@startuml export_data

left to right direction
skinparam packageStyle rect

actor "Chủ bãi đỗ" as ParkingOwner

rectangle "Xuất dữ liệu" as ExportData {
  'ParkingOwner'
    (Trích xuất thông tin bãi đỗ) -- ParkingOwner
    (Trích xuất thông tin nhân viên) -- ParkingOwner
    (Trích xuất thông tin đặt vé) -- ParkingOwner
}

@enduml