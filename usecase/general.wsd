@startuml general

left to right direction
skinparam packageStyle rect

actor "Chủ bãi đỗ" as ParkingOwner
actor "Nhân viên bãi đỗ" as ParkingStaff

actor "Chủ phương tiện" as VehicleOwner

rectangle "Tổng quan" as GeneralDiagram {
  'ParkingStaff'
    ParkingStaff -- (Xem vé đỗ xe)
    ParkingStaff -- (Quét vé đỗ xe)
    ParkingStaff -- (Chấm công)
    ParkingStaff -- (Nhận thông báo)
  'ParkingOwner'
    ParkingOwner -- (Quản lý thông tin bãi đỗ)
    ParkingOwner -- (Xem vé đỗ xe)
    ParkingOwner -- (Trích Xuất dữ liệu)
    ParkingOwner -- (Quét vé đỗ xe)
    ParkingOwner -- (Quản lý nhân viên)
    ParkingOwner -- (Nhận thông báo)
  'VehicleOwner'
    (Quản lý thông tin) --- VehicleOwner
    (Đặt, hủy và thanh toán vé đỗ xe) --- VehicleOwner
    (Nhận thông báo) --- VehicleOwner
    (Tìm kiếm bãi đỗ xe) --- VehicleOwner
    (Xem vé đỗ xe) --- VehicleOwner
  'Ext use case'
    (Gửi thông báo) .up.> (Quét vé đỗ xe): <<Include>>
}
@enduml